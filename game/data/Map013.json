{"id":2,"name":"EV002","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":241,"indent":0,"parameters":[{"name":"Ship2","volume":60,"pitch":100,"pan":0}]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":[" Setelah melalui berbagai rintangan dan ancaman, akhirnya "]},{"code":401,"indent":0,"parameters":[" Pulau Gurah kembali pulih. Hutan yang sempat rusak kini "]},{"code":401,"indent":0,"parameters":["menghijau kembali, dan masyarakat kembali hidup sejahtera."]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["  Semua ini terjadi berkat keberanianmu dalam melindungi "]},{"code":401,"indent":0,"parameters":["dan menghadapi ancaman dari Bajak Laut. Engkau bukan sekadar "]},{"code":401,"indent":0,"parameters":["   penyelamat, tetapi panutan bagi generasi mendatang."]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":[" Setelah menyelesaikan seluruh misi penyelamatan lingkungan "]},{"code":401,"indent":0,"parameters":["  di Pulau Gurah, Jack Miller menyadari pentingnya menjaga "]},{"code":401,"indent":0,"parameters":["seimbangan antara manusia dan alam. Lingkungan hidup terdiri "]},{"code":401,"indent":0,"parameters":["   dari komponen biotik seperti tumbuhan dan hewan."]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":[" Misi ini memang telah selesai, tetapi tugasmu sebagai "]},{"code":401,"indent":0,"parameters":["  Pahlawan Lingkungan belum berakhir. Masih banyak tempat "]},{"code":401,"indent":0,"parameters":[" lain yang menanti perubahan. Teruslah bergerak, teruslah "]},{"code":401,"indent":0,"parameters":["       peduli, dan teruslah menjadi suara bagi alam."]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["   abiotik seperti tanah, air, dan udara yang saling "]},{"code":401,"indent":0,"parameters":["  memengaruhi. Interaksi manusia dengan lingkungan dapat "]},{"code":401,"indent":0,"parameters":[" membawa dampak positif jika dikelola dengan bijak, namun "]},{"code":401,"indent":0,"parameters":["juga dapat merusak jika dilakukan secara berlebihan. Dalam "]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["   perjalanannya, Jack mempelajari berbagai potensi dan "]},{"code":401,"indent":0,"parameters":["persebaran sumber daya alam, baik hayati seperti hasil laut "]},{"code":401,"indent":0,"parameters":["                        dan hutan"]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["Dalam petualangannya di Pulau Gurah, Jack Miller menyaksikan "]},{"code":401,"indent":0,"parameters":["  bagaimana masyarakat pesisir menjaga hubungan harmonis "]},{"code":401,"indent":0,"parameters":["   dengan alam melalui tradisi petik laut. Tradisi ini "]},{"code":401,"indent":0,"parameters":["    merupakan bentuk kearifan lokal yang mencerminkan "]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":[" rasa syukur terhadap hasil laut sekaligus wujud kepedulian "]},{"code":401,"indent":0,"parameters":["  terhadap kelestarian lingkungan. Jack belajar bahwa laut "]},{"code":401,"indent":0,"parameters":["   sebagai sumber daya alam hayati perlu dijaga agar tidak "]},{"code":401,"indent":0,"parameters":["   habis karena eksploitasi berlebihan. Melalui petik laut, "]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["  masyarakat mengajarkan bahwa interaksi manusia dengan "]},{"code":401,"indent":0,"parameters":["  lingkungan harus seimbang — mengambil secukupnya, dan "]},{"code":401,"indent":0,"parameters":["                 merawat sepenuhnya."]},{"code":123,"indent":0,"parameters":["A",0]},{"code":201,"indent":0,"parameters":[0,15,8,4,0,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":10,"y":1},
