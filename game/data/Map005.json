{"id":1,"name":"EV001","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":241,"indent":0,"parameters":[{"name":"Ship2","volume":60,"pitch":100,"pan":0}]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["Topik: Lingkungan Sebagai Habitat Hidup Berkelanjutan"]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["Indikator Pencapaian Kompetensi (IPK)"]},{"code":401,"indent":0,"parameters":["1.Mengidentifikasi komponen lingkungan hidup "]},{"code":401,"indent":0,"parameters":["  (biotik dan abiotik)."]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["2.Menjelaskan bentuk interaksi manusia dengan lingkungan "]},{"code":401,"indent":0,"parameters":["  dan dampaknya."]},{"code":401,"indent":0,"parameters":["3.Mengidentifikasi jenis-jenis sumber daya alam dan "]},{"code":401,"indent":0,"parameters":["  karakteristiknya."]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["4.Menganalisis persebaran SDA di Indonesia."]},{"code":401,"indent":0,"parameters":["5.Menjelaskan upaya pelestarian lingkungan dan pengelolaan "]},{"code":401,"indent":0,"parameters":["  SDA secara berkelanjutan."]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["  Haloo teman - teman kenalin aku Jack Miller kamu bisa "]},{"code":401,"indent":0,"parameters":["  pangil aku Jack. Aku tinggal di Pulau Gurah, pulau ini"]},{"code":401,"indent":0,"parameters":["memiliki banyak sumber daya alam. Warga setempat juga sangat"]},{"code":401,"indent":0,"parameters":["             menjaga kelestarian alam disini."]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["        Kekayaan alam di Pulau Gurah berupa keaneka"]},{"code":401,"indent":0,"parameters":[" ragamaan flora dan fauna, sumber mata air, hasil laut, dan"]},{"code":401,"indent":0,"parameters":["   hasil pertaniaan yang melimpah. Pulau ini sangat subur"]},{"code":401,"indent":0,"parameters":["    sehingga kehidupan warga desa makmur dan sejahtera."]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":[" Namun, keindahan dan kelestarian Pulau Gurah tidak lepas "]},{"code":401,"indent":0,"parameters":["   dari ancaman. Ulah tangan manusia yang serakah terus"]},{"code":401,"indent":0,"parameters":["     membayangi, siap merusak lingkungan demi mengeruk "]},{"code":401,"indent":0,"parameters":["            sumber daya alam tanpa henti. "]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":[" Kerusakan ini harus kita hentikan dengan segala upaya, "]},{"code":401,"indent":0,"parameters":["   demi menjaga masa depan pulau yang berkelanjutan."]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["Bersiaplah untuk petualangan seru! Kita akan menjelajahi "]},{"code":401,"indent":0,"parameters":[" Pulau Gurah, menyingkap setiap sudut keindahannya yang "]},{"code":401,"indent":0,"parameters":["memukau sambil menyelami upaya pelestarian lingkungannya "]},{"code":401,"indent":0,"parameters":["                   yang luar biasa. "]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":[" Tak hanya menikmati pesona alamnya, kita juga akan banyak "]},{"code":401,"indent":0,"parameters":["  belajar tentang bagaimana menjaga harmoni dengan alam "]},{"code":401,"indent":0,"parameters":["              di pulau menakjubkan ini"]},{"code":241,"indent":0,"parameters":[{"name":"Ship2","volume":60,"pitch":100,"pan":0}]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["  Aku akan memberitahumu cara bermain game ini mari kita"]},{"code":401,"indent":0,"parameters":["                   simak sama - sama.."]},{"code":231,"indent":0,"parameters":[1,"Cara bermain game",1,0,400,248,80,80,255,0]},{"code":102,"indent":0,"parameters":[["Baik Saya Paham"],-1,0,2,1]},{"code":402,"indent":0,"parameters":[0,"Baik Saya Paham"]},{"code":235,"indent":1,"parameters":[1]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["   Mari kita simak juga rute perjalanan kita nantinya..."]},{"code":231,"indent":0,"parameters":[1,"Lokasi",1,0,408,248,80,80,255,0]},{"code":102,"indent":0,"parameters":[["Baik Saya Paham"],-1,0,2,1]},{"code":402,"indent":0,"parameters":[0,"Baik Saya Paham"]},{"code":235,"indent":1,"parameters":[1]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["    Bahaya yang ditakutkan kini menjadi kenyataan. "]},{"code":401,"indent":0,"parameters":["  Bajak laut telah datang dan siap merebut Pulau Gurah. "]},{"code":401,"indent":0,"parameters":["Kita memiliki tanggung jawab besar untuk segera bertindak "]},{"code":401,"indent":0,"parameters":["  dan menyelamatkan pulau ini dari ancaman kehancuran!"]},{"code":242,"indent":0,"parameters":[4]},{"code":201,"indent":0,"parameters":[0,1,8,6,0,0]},{"code":0,"indent":0,"parameters":[]}],"move